# ============================================================
# LocalDevAI — Configuration
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env with real secrets.
# ============================================================

# --- Gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8099
# Set to 0.0.0.0 only if you need remote access (requires auth)
# GATEWAY_HOST=0.0.0.0

# --- Authentication ---
# Admin password (required on first run — will be hashed and stored)
ADMIN_PASSWORD=
# API key for OpenAI-compatible endpoints (optional, recommended for remote)
API_KEY=
# Session secret (auto-generated if empty)
SESSION_SECRET=

# --- LLM Backend (llama.cpp) ---
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_TIMEOUT=120000
DEFAULT_MODEL=local-model

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=localdevai:

# --- SearXNG ---
SEARXNG_BASE_URL=http://127.0.0.1:8888

# --- Web Research & Reader ---
WEB_RESEARCH_ENABLED=true
WEB_READER_ENABLED=true
WEB_MAX_RESULTS=5
WEB_MAX_CONCURRENT=3
WEB_TIMEOUT=15000
WEB_MAX_CONTENT_LENGTH=12000
WEB_CACHE_ENABLED=true
WEB_CACHE_TTL=3600

# --- Context Auto Management ---
# NEW_SESSION em 0.80 é o ideal: deixa 20% de margem para a resposta da IA sem estourar o limite.
# Esperar até 0.90+ causa truncamento ou falha em respostas longas.
CONTEXT_AUTO_MANAGEMENT=true
CONTEXT_WARNING_THRESHOLD=0.65
CONTEXT_CHECKPOINT_THRESHOLD=0.75
CONTEXT_NEW_SESSION_THRESHOLD=0.80
CONTEXT_MAX_THRESHOLD=0.90

# --- Database ---
DB_PATH=./data/localdevai.db

# --- Data directories ---
DATA_DIR=./data
LOG_DIR=./data/logs

# --- Context defaults (tokens) ---
MAX_CONTEXT_TOKENS=8192
MAX_RESPONSE_TOKENS=2048
SYSTEM_PROMPT_BUDGET=500
PROJECT_PROMPT_BUDGET=300
SUMMARY_BUDGET=400
MAX_HISTORY_MESSAGES=20
MAX_MEMORIES_PER_REQUEST=10
MEMORY_TOKEN_BUDGET=800
RAG_TOKEN_BUDGET=1200
HISTORY_TOKEN_BUDGET=2000
SAFETY_MARGIN_TOKENS=200

# --- Knowledge ingestion ---
INGEST_MAX_PAGE_SIZE=2000000
INGEST_TIMEOUT=30000
INGEST_MAX_CONCURRENT=2
INGEST_MAX_CRAWL_DEPTH=3
INGEST_MAX_PAGES_PER_SOURCE=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Rate limiting ---
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=60

# --- Logging ---
LOG_LEVEL=info
# Levels: error, warn, info, debug

# --- MCP ---
MCP_SERVER_PATH=./mcp/server.mjs
